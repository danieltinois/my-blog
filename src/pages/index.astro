---
import NavNextAndPrevious from "@components/navigation/NavNextAndPrevious.astro";
import PostCard from "@components/post/PostCard.astro";
import PostLink from "@components/post/components/PostLink.astro";
import Base from "@layouts/base.astro";

const apiBaseUrl = import.meta.env.API_BASE_URL;

const url = new URL(Astro.request.url);
const page = Number(url.searchParams.get("page") || "1");
const limit = Number(url.searchParams.get("limit") || "5");

const apiUrl = `${apiBaseUrl}/posts?page=${page}&limit=${limit}`;
const response = await fetch(apiUrl);
const result = await response.json();

const postsList = result.data || [];
const total = result.total || postsList.length;
const totalPages = Math.max(1, Math.ceil(total / limit));

const apiUrlFixedPosts = `${apiBaseUrl}/posts/fixed-posts`;
const responseFixedPosts = await fetch(apiUrlFixedPosts);
const findFixedPosts = await responseFixedPosts.json();

const postsFixedList = findFixedPosts.data || [];
---

<Base pageTitle="Home">
  <section aria-label="Introdução do blog" class="home-hero">
    <p class="home-eyebrow">
      Diário (quase) organizado de engenharia e produto
    </p>

    <h1 class="home-title">
      Construindo software, errando no processo e escrevendo sobre isso depois.
    </h1>

    <p class="home-subtitle">
      Aqui tem código, decisões duvidosas, aprendizados reais e algumas opiniões
      que ninguém pediu... Tudo pra quem curte criar produto de verdade, sem
      firula e sem romantizar demais.
    </p>
  </section>

  {
    postsFixedList.length ? (
      <section class="mobile-pinned" aria-label="Posts fixados">
        <p class="home-eyebrow">Posts fixados</p>
        <div class="mobile-pinned-track">
          {postsFixedList.map((p: any) => (
            <a class="mobile-pinned-item" href={`/post/${p.id}`}>
              {p.title}
            </a>
          ))}
        </div>
      </section>
    ) : null
  }

  <section class="home-layout" aria-label="Conteúdo principal">
    <div class="home-main">
      <div class="post-list">
        {
          postsList.map((post: any) => (
            <PostCard
              title={post.title}
              description={post.description}
              pubDate={new Date(post.publishedAt)}
              url={`/post/${post.id}`}
              tags={post.tags}
            />
          ))
        }
      </div>

      <NavNextAndPrevious page={page} totalPages={totalPages} limit={limit} />
    </div>

    <aside class="home-sidebar" aria-label="Barra lateral">
      <div class="sidebar-card">
        <h2 class="sidebar-title">Posts fixados</h2>
        <div class="mobile-fixed-list">
          {
            postsFixedList.length ? (
              postsFixedList.map((p: any) => (
                <PostLink title={p.title} url={`/post/${p.id}`} />
              ))
            ) : (
              <span class="text-tx-dimmed text-sm">
                Nenhum post fixado no momento.
              </span>
            )
          }
        </div>
      </div>
    </aside>
  </section>
</Base>
