---
import { Icon } from "astro-icon/components";

interface Props {
  page?: number;
  totalPages?: number;
  limit?: number;
}

const { page: pageProp, totalPages: totalPagesProp, limit: limitProp } =
  Astro.props as Props;

const url = new URL(Astro.request.url);
const page = pageProp ?? Number(url.searchParams.get("page") || "1");
const limit = limitProp ?? Number(url.searchParams.get("limit") || "5");

const totalPages =
  totalPagesProp ??
  (() => {
    const total = Number(url.searchParams.get("total") || "1");
    return Math.max(1, total);
  })();
---

<nav class="pagination" aria-label="Paginação de posts">
  {
    page > 1 ? (
      <a class="pagination-button" href={`/?page=${page - 1}&limit=${limit}`}>
        <Icon name="lucide:arrow-left" class="size-4" />
        Anterior
      </a>
    ) : (
      <span class="pagination-button" aria-disabled="true">
        <Icon name="lucide:arrow-left" class="size-4" />
        Anterior
      </span>
    )
  }

  <span class="pagination-indicator">Página {page} de {totalPages}</span>

  {
    page < totalPages ? (
      <a class="pagination-button" href={`/?page=${page + 1}&limit=${limit}`}>
        Próxima
        <Icon name="lucide:arrow-right" class="size-4" />
      </a>
    ) : (
      <span class="pagination-button" aria-disabled="true">
        Próxima
        <Icon name="lucide:arrow-right" class="size-4" />
      </span>
    )
  }
</nav>
