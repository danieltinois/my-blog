---
import { Icon } from "astro-icon/components";

interface Props {
  page?: number;
  totalPages?: number;
  limit?: number;
  basePath?: string;
  queryParams?: Record<string, string | number | boolean | undefined>;
}

const {
  page: pageProp,
  totalPages: totalPagesProp,
  limit: limitProp,
  basePath = "/",
  queryParams = {},
} = Astro.props as Props;

const url = new URL(Astro.request.url);
const page = pageProp ?? Number(url.searchParams.get("page") || "1");
const limit = limitProp ?? Number(url.searchParams.get("limit") || "5");

const totalPages =
  totalPagesProp ??
  (() => {
    const total = Number(url.searchParams.get("total") || "1");
    return Math.max(1, total);
  })();

const buildPageUrl = (nextPage: number) => {
  const params = new URLSearchParams();

  Object.entries(queryParams).forEach(([key, value]) => {
    if (value !== undefined) {
      params.set(key, String(value));
    }
  });

  params.set("page", String(nextPage));
  params.set("limit", String(limit));

  return `${basePath}?${params.toString()}`;
};
---

<nav class="pagination" aria-label="Paginação de posts">
  {
    page > 1 ? (
      <a class="pagination-button" href={buildPageUrl(page - 1)}>
        <Icon name="lucide:arrow-left" class="size-4" />
        Anterior
      </a>
    ) : (
      <span class="pagination-button" aria-disabled="true">
        <Icon name="lucide:arrow-left" class="size-4" />
        Anterior
      </span>
    )
  }

  <span class="pagination-indicator">Página {page} de {totalPages}</span>

  {
    page < totalPages ? (
      <a class="pagination-button" href={buildPageUrl(page + 1)}>
        Próxima
        <Icon name="lucide:arrow-right" class="size-4" />
      </a>
    ) : (
      <span class="pagination-button" aria-disabled="true">
        Próxima
        <Icon name="lucide:arrow-right" class="size-4" />
      </span>
    )
  }
</nav>
