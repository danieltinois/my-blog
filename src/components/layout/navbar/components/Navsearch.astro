---
interface Props {
  placeholder: string;
  inputId?: string;
  showShortcut?: boolean;
  className?: string;
}

const {
  placeholder,
  inputId = "search-input",
  showShortcut = true,
  className = "",
} = Astro.props as Props;
---

<form action="/search" role="search" class={`search-form ${className}`.trim()}>
  <input
    id={inputId}
    data-search-input="true"
    type="search"
    placeholder={placeholder}
    class="search-input"
  />

  {
    showShortcut ? (
      <kbd class="search-shortcut">
        <span data-kbd-platform>⌘</span>K
      </kbd>
    ) : null
  }
</form>

<script>
  import { initSearchShortcut } from "@lib/search-shortcut";

  initSearchShortcut();

  document.addEventListener("astro:page-load", initSearchShortcut);
</script>
