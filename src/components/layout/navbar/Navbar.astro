---
import Navgithub from "./components/Navgithub.astro";
import Navsearch from "./components/Navsearch.astro";
import Navtheme from "./components/Navtheme.astro";
import PostLink from "@components/post/components/PostLink.astro";

const apiBase = import.meta.env.API_BASE_URL || "";
let postsFixedList: any[] = [];

try {
  if (apiBase) {
    const apiUrlFixedPosts = `${apiBase}/posts/fixed-posts`;
    const responseFixedPosts = await fetch(apiUrlFixedPosts);
    const findFixedPosts = await responseFixedPosts.json();
    postsFixedList = findFixedPosts.data || [];
  }
} catch {
  postsFixedList = [];
}
---

<header class="site-header">
  <div class="site-header-inner">
    <div class="site-header-main">
      <a href="/" class="brand-link" aria-label="Voltar para home">
        <span class="brand-name">danielporai</span>
        <span class="brand-domain">.com</span>
      </a>

      <div class="nav-actions-desktop">
        <Navsearch
          placeholder="Buscar posts"
          inputId="search-input-desktop"
          className="w-[14rem] transition-[width] duration-300 focus-within:w-[20rem] xl:w-[16rem] xl:focus-within:w-[24rem]"
        />
        <Navgithub />
        <Navtheme />
      </div>

      <div class="nav-actions-mobile">
        <Navtheme />
        <Navgithub />
        <button
          id="mobile-menu-toggle"
          class="icon-action"
          aria-controls="mobile-menu-panel"
          aria-expanded="false"
          aria-label="Abrir menu"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="size-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"
            ></path>
          </svg>
        </button>
      </div>
    </div>

    <div class="mobile-search-row">
      <Navsearch
        placeholder="Buscar posts"
        inputId="search-input-mobile"
        showShortcut={false}
      />
    </div>

    <div id="mobile-menu-panel" class="mobile-menu-panel" data-open="false">
      <p class="mobile-menu-title">Posts fixados</p>
      <div class="mobile-fixed-list">
        {
          postsFixedList.length ? (
            postsFixedList.map((p: any) => (
              <PostLink title={p.title} url={`/post/${p.id}`} />
            ))
          ) : (
            <span class="text-tx-dimmed text-sm">Nenhum post fixado no momento.</span>
          )
        }
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const panel = document.getElementById("mobile-menu-panel");

  if (toggle && panel) {
    const setMenuState = (isOpen: boolean) => {
      panel.setAttribute("data-open", String(isOpen));
      toggle.setAttribute("aria-expanded", String(isOpen));
    };

    toggle.addEventListener("click", () => {
      const isOpen = panel.getAttribute("data-open") === "true";
      setMenuState(!isOpen);
    });

    document.addEventListener("click", (event) => {
      const target = event.target as Node;
      const clickedOutside = !panel.contains(target) && !toggle.contains(target);
      const isOpen = panel.getAttribute("data-open") === "true";

      if (clickedOutside && isOpen) {
        setMenuState(false);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        setMenuState(false);
      }
    });

    document.addEventListener("astro:after-swap", () => setMenuState(false));
  }
</script>
