---
import PostTag from "./components/PostTag.astro";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  url: string;
  tags?: string[];
}

const { title, description, pubDate, url, tags } = Astro.props as Props;

const formattedDate = pubDate.toLocaleDateString("pt-BR", {
  day: "2-digit",
  month: "short",
  year: "numeric",
});
---

<a href={url} class="card-link" aria-label={`Abrir post ${title}`}>
  <article class="card-body">
    <div class="card-meta">
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
      {
        tags?.length ? (
          <div class="flex flex-wrap items-center gap-1.5">
            {tags.map((tag) => (
              <PostTag title={tag} size={11} />
            ))}
          </div>
        ) : null
      }
    </div>

    <h2 class="card-title">{title}</h2>

    <p class="card-description">{description}</p>

    <span class="card-cta">
      Ler artigo
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="size-4"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M13 7l5 5m0 0l-5 5m5-5H6"
        ></path>
      </svg>
    </span>
  </article>
</a>
